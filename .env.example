# Copy this file to .env and fill in your Supabase project values.
# These are read by Expo/Metro at build time (EXPO_PUBLIC_ prefix required
# for a variable to be exposed to client code) and are safe to ship in the
# app bundle — the anon key is a public, RLS-protected key, not a secret.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
